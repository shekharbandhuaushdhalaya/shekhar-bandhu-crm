{
  "expo": {
    "name": "Shekhar Bandhu CRM",
    "slug": "shekhar-bandhu-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shekhar-bandhu-crm",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5F7F4",
      "image": "./assets/logo.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexcrm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F4"
      },
      "package": "com.apexcrm.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
