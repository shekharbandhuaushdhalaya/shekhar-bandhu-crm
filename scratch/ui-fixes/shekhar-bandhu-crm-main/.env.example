# ── Server / Backend Configuration (Render / Production) ─────
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shekhar-bandhu-crm?retryWrites=true&w=majority
JWT_SECRET=your-long-random-jwt-secret-min-32-characters
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30
# Exact HTTPS browser origins only in production. Add both CRM and public website origins.
ALLOWED_ORIGINS=https://shekhar-bandhu-crm.vercel.app,https://shekharbandhuaushdhalaya.in
TRUST_PROXY=true
ENFORCE_TENANCY=true
WORKER_POLL_MS=2000

# ── Cloudinary (Product Images & Attachments) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Gemini AI (Analytics Assistant & Chatbot) ────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Payments (Razorpay) ──────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── WhatsApp & SMS Notifications (Twilio) ───────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Meta / Social Integration ────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://shekhar-bandhu-crm-backend.onrender.com/api/social/callback

# ── Transactional Email (Resend) ─────────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Shekhar Bandhu CRM <noreply@shekharbandhuaushdhalaya.in>
COURIER_WEBHOOK_SECRET=your_courier_webhook_secret

# ── Operational Flags ────────────────────────────────────────
RUN_STARTUP_MIGRATIONS=false
ALLOW_DB_RESET=false

