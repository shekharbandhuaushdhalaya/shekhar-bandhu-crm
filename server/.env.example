NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://...
JWT_SECRET=generate-a-long-random-secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=https://your-crm-domain.example
TRUST_PROXY=true
ENFORCE_TENANCY=true
WORKER_POLL_MS=2000
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_APP_ID=
META_APP_SECRET=

# Operational controls
RUN_STARTUP_MIGRATIONS=false
ALLOW_DB_RESET=false

RESEND_API_KEY=
EMAIL_FROM=CRM <noreply@example.com>
COURIER_WEBHOOK_SECRET=

PUBLIC_FIRM_ID=
